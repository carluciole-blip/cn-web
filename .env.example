# Copier en .env.local pour le développement. Toutes les valeurs ci-dessous sont factices.
# En production, les vraies valeurs se saisissent dans les réglages de Netlify, jamais dans le dépôt.

# Identité et pages légales (affichées « [à compléter] » tant qu'elles manquent)
SITE_URL=http://localhost:3000
EMAIL_CONTACT=contact@exemple.test
EMAIL_ADMIN=admin@exemple.test
DATE_OUVERTURE=1er décembre 2026
RAISON_SOCIALE=
SIRET=
ADRESSE=
MENTION_TVA=
DIRECTION_PUBLICATION=
HEBERGEUR_MENTION=
# Mettre "non" une fois les passages juridiques validés
AFFICHER_REPERES_JURIDIQUES=oui

# Supabase (clé secrète : serveur seulement)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_factice
SUPABASE_PUBLISHABLE_KEY=sb_publishable_factice

# Stripe
STRIPE_SECRET_KEY=sk_test_factice
STRIPE_WEBHOOK_SECRET=whsec_factice

# E-mails (Brevo en SMTP en production, Mailpit du Supabase local en développement)
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
EMAIL_EXPEDITEUR="Château Nerval <invitations@exemple.test>"
EMAIL_QUOTA_JOUR=300

# Secrets de l'application (longues chaînes aléatoires, par exemple : openssl rand -base64 48)
CRON_SECRET=factice
JETON_SECRET=factice
